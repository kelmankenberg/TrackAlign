# Public Spotify application configuration for local development.
# Do not add secrets here. Desktop OAuth uses PKCE.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43821/callback

# Public GitHub OAuth App client ID for the in-app feedback/discussions feature.
# Do not add secrets here. Desktop auth uses the OAuth Device Flow (no client secret).
GITHUB_CLIENT_ID=
