{
  "name": "trackalign",
  "version": "0.1.0",
  "description": "Match local audio files to Spotify collection order and rename them safely.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:linux": "electron-vite build && electron-builder --linux --publish=never",
    "package:win": "electron-vite build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^18.0.3",
    "lucide-react": "latest",
    "music-metadata": "^11.16.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "latest",
    "typescript": "latest",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.trackalign.app",
    "productName": "TrackAlign",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "TrackAlign"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
